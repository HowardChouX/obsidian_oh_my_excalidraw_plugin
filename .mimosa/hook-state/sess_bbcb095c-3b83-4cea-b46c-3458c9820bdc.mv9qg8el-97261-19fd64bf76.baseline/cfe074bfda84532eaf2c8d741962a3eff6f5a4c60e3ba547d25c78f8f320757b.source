/**
 * API-key obfuscation was removed together with the AI provider feature.
 * These pass-throughs remain so settings persistence keeps a single choke
 * point where sensitive-value handling can be reintroduced if ever needed.
 */
export const decryptPersistedAPIKeys = <T>(settings: T): T => settings;

export const encryptPersistedAPIKeys = <T>(settings: T): T => settings;
