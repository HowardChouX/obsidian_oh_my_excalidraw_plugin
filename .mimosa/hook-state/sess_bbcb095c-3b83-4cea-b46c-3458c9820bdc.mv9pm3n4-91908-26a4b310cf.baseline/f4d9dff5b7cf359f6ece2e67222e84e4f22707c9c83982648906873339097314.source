import { Notice, TextFileView, WorkspaceLeaf, TFile } from "obsidian";
import { createElement } from "react";
import { createRoot, type Root } from "react-dom/client";
import { Excalidraw, FONT_FAMILY } from "@excalidraw/excalidraw";
import type { ExcalidrawImperativeAPI } from "@excalidraw/excalidraw/types";
import type { AppState, BinaryFiles } from "@excalidraw/excalidraw/types";
import type { OrderedExcalidrawElement } from "@excalidraw/excalidraw/element/types";
import OhMyExcalidrawPlugin from "./main";
import {
  createBlankScene,
  isExcalidrawMarkdown,
  mergeAppState,
  parseDrawing,
  serializeDrawing,
  type ParsedDrawing,
  type SceneData,
} from "./data";
import { t } from "./lang";

export const VIEW_TYPE_EXCALIDRAW = "oh-my-excalidraw";

const FONT_BY_SETTING = {
  excalifont: (FONT_FAMILY as Record<string, number>).Excalifont,
  "hand-drawn": (FONT_FAMILY as Record<string, number>).Virgil,
  normal: (FONT_FAMILY as Record<string, number>).Helvetica,
  code: (FONT_FAMILY as Record<string, number>).Cascadia,
} as const;

function ExcalidrawApp(props: { view: ExcalidrawView }) {
  const { view } = props;
  return createElement(Excalidraw, {
    excalidrawAPI: (api: ExcalidrawImperativeAPI) => view.onApiReady(api),
    initialData: () => view.buildInitialData(),
    onChange: (
      elements: readonly OrderedExcalidrawElement[],
      appState: AppState,
      files: BinaryFiles,
    ) => view.onSceneChange(elements, appState, files),
    theme: view.currentTheme,
    viewModeEnabled: view.locked,
    langCode: view.editorLanguage(),
    name: view.fileBasename(),
    UIOptions: {
      canvasActions: {
        loadScene: false,
        saveToActiveFile: false,
        export: false,
        saveAsImage: false,
        toggleTheme: false,
      },
      tools: { image: true },
    },
  } as any);
}

export default class ExcalidrawView extends TextFileView {
  public excalidrawAPI: ExcalidrawImperativeAPI | null = null;
  public locked = false;

  private plugin: OhMyExcalidrawPlugin;
  private reactRoot: Root | null = null;
  private themeObserver: MutationObserver | null = null;

  private parsed: ParsedDrawing | null = null;
  private scene: SceneData;
  /** Set when the file could not be parsed: raw content is passed through untouched. */
  private loadFailed = false;
  private rawContent = "";

  private currentElements: readonly OrderedExcalidrawElement[] | null = null;
  private currentAppState: Partial<AppState> | null = null;
  private currentFiles: BinaryFiles | null = null;

  constructor(leaf: WorkspaceLeaf, plugin: OhMyExcalidrawPlugin) {
    super(leaf);
    this.plugin = plugin;
    this.scene = createBlankScene(false);
  }

  getViewType(): string {
    return VIEW_TYPE_EXCALIDRAW;
  }

  getDisplayText(): string {
    const name = this.file?.basename ?? "Excalidraw";
    return name.replace(/\.excalidraw$/, "");
  }

  getIcon(): string {
    return "oh-my-excalidraw";
  }

  get currentTheme(): "light" | "dark" {
    const body = this.containerEl.ownerDocument.body;
    return body.hasClass("theme-dark") ? "dark" : "light";
  }

  fileBasename(): string {
    return this.getDisplayText();
  }

  editorLanguage(): "zh-CN" | "en" {
    const setting = this.plugin.settings.editorLanguage;
    if (setting !== "auto") {
      return setting;
    }
    return window.moment().locale().toLowerCase().startsWith("zh")
      ? "zh-CN"
      : "en";
  }

  async onOpen(): Promise<void> {
    this.contentEl.addClass("oh-my-excalidraw-view");
    this.mountExcalidraw();
    this.watchTheme();
  }

  private mountExcalidraw(): void {
    if (!this.reactRoot) {
      this.reactRoot = createRoot(this.contentEl);
    }
    this.renderApp();
  }

  private renderApp(): void {
    this.reactRoot?.render(createElement(ExcalidrawApp, { view: this }));
  }

  private watchTheme(): void {
    const body = this.containerEl.ownerDocument.body;
    let lastTheme = this.currentTheme;
    this.themeObserver = new MutationObserver(() => {
      const theme = this.currentTheme;
      if (theme !== lastTheme) {
        lastTheme = theme;
        this.renderApp();
      }
    });
    this.themeObserver.observe(body, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }

  onApiReady(api: ExcalidrawImperativeAPI): void {
    this.excalidrawAPI = api;
    // The view may have received data before the React tree mounted.
    if (this.parsed) {
      this.applySceneToApi(true);
    }
  }

  buildInitialData() {
    const fontFamily =
      FONT_BY_SETTING[this.plugin.settings.defaultFont] ??
      (FONT_FAMILY as Record<string, number>).Excalifont;
    return {
      elements: this.scene.elements,
      appState: {
        ...this.scene.appState,
        currentItemFontFamily: fontFamily,
      },
      files: this.scene.files,
      scrollToContent: this.scene.elements.length > 0,
    };
  }

  onSceneChange(
    elements: readonly OrderedExcalidrawElement[],
    appState: AppState,
    files: BinaryFiles,
  ): void {
    if (this.loadFailed || !this.parsed) {
      return;
    }
    this.currentElements = elements;
    this.currentAppState = appState;
    this.currentFiles = files;
    this.requestSave();
  }

  // --- TextFileView contract -------------------------------------------------

  setViewData(data: string, clear: boolean): void {
    this.rawContent = data;
    this.data = data;
    const parsed = parseDrawing(data);

    if (!parsed.rawJson && !parsed.scene && !isExcalidrawMarkdown(data)) {
      // Not a drawing file: never rewrite it.
      this.loadFailed = true;
      this.parsed = null;
      new Notice(
        `${this.file?.name}: not an Excalidraw drawing — opened read-only.`,
      );
      return;
    }
    this.loadFailed = false;

    // Reload-own-write guard: our own save echoes back through the modify
    // event; applying it would drop selection and flicker the canvas.
    if (!clear && this.parsed && data === this.getViewData()) {
      return;
    }

    this.parsed = parsed;
    this.scene = parsed.scene ?? createBlankScene(this.currentTheme === "dark");
    this.currentElements = null;
    this.currentAppState = null;
    this.currentFiles = null;

    if (this.excalidrawAPI) {
      this.applySceneToApi(clear);
    }
  }

  private applySceneToApi(scroll: boolean): void {
    const api = this.excalidrawAPI;
    if (!api) {
      return;
    }
    api.updateScene({
      elements: this.scene.elements,
      appState: {
        ...this.scene.appState,
        selectedElementIds: {},
      } as any,
    });
    const files = Object.values(this.scene.files);
    if (files.length > 0) {
      api.addFiles(files as any);
    }
    if (scroll && this.scene.elements.length > 0) {
      api.scrollToContent(undefined as any, { fitToViewport: true });
    }
  }

  getViewData(): string {
    if (this.loadFailed || !this.parsed) {
      return this.rawContent;
    }
    const scene: SceneData = {
      ...this.scene,
      elements: this.currentElements ?? this.scene.elements,
      appState: mergeAppState(
        this.scene.appState,
        this.currentAppState ?? {},
      ),
      files: this.currentFiles ?? this.scene.files,
    };
    return serializeDrawing(this.parsed, scene, {
      compress: this.plugin.settings.compress,
    });
  }

  clear(): void {
    this.parsed = null;
    this.scene = createBlankScene(this.currentTheme === "dark");
    this.currentElements = null;
    this.currentAppState = null;
    this.currentFiles = null;
  }

  async onClose(): Promise<void> {
    try {
      await this.save();
    } catch (e) {
      console.error("[Oh My Excalidraw] save on close failed", e);
    }
    this.themeObserver?.disconnect();
    this.themeObserver = null;
    this.excalidrawAPI = null;
    this.reactRoot?.unmount();
    this.reactRoot = null;
    await super.onClose();
  }

  async onUnloadFile(file: TFile): Promise<void> {
    try {
      await this.save();
    } catch (e) {
      console.error("[Oh My Excalidraw] save on unload failed", e);
    }
  }

  // --- actions ---------------------------------------------------------------

  toggleLock(): void {
    this.locked = !this.locked;
    this.renderApp();
    new Notice(this.locked ? t("locked") : t("unlocked"));
  }

  /** Current scene for exports and embeds. */
  getScene(): {
    elements: readonly OrderedExcalidrawElement[];
    appState: Partial<AppState>;
    files: BinaryFiles;
  } {
    return {
      elements: this.currentElements ?? this.scene.elements,
      appState: this.currentAppState ?? this.scene.appState,
      files: this.currentFiles ?? this.scene.files,
    };
  }

  getDrawingFile(): TFile | null {
    return this.file;
  }
}
