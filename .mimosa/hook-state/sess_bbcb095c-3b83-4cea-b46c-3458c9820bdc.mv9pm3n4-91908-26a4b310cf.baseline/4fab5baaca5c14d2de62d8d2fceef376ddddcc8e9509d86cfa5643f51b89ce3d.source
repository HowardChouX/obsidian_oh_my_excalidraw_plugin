import {
  addIcon,
  FuzzySuggestModal,
  MarkdownView,
  Menu,
  Notice,
  Plugin,
  TFile,
  WorkspaceLeaf,
  normalizePath,
} from "obsidian";
import {
  DEFAULT_SETTINGS,
  SettingsTab,
  type PluginSettings,
} from "./settings";
import ExcalidrawView, { VIEW_TYPE_EXCALIDRAW } from "./view";
import { EmbedManager } from "./embed";
import { createBlankDrawing } from "./data";
import { t } from "./lang";
import { copyPngToClipboard, copySvgToClipboard, savePng, saveSvg } from "./exporter";
import "@excalidraw/excalidraw/index.css";
import "./styles.css";

const ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4l10.5-10.5a2.12 2.12 0 0 0-3-3L5 17v3z"/><path d="M12.5 6.5l5 5"/></svg>`;

export default class OhMyExcalidrawPlugin extends Plugin {
  public settings!: PluginSettings;
  private embedManager!: EmbedManager;
  /** Files the user explicitly opened as markdown this session (skip auto-switch). */
  private markdownOverride = new Set<string>();

  async onload(): Promise<void> {
    await this.loadSettings();
    this.addSettingTab(new SettingsTab(this.app, this));

    addIcon("oh-my-excalidraw", ICON_SVG);
    this.registerView(
      VIEW_TYPE_EXCALIDRAW,
      (leaf: WorkspaceLeaf) => new ExcalidrawView(leaf, this),
    );
    // Pure .excalidraw JSON files (no markdown wrapper).
    this.registerExtensions(["excalidraw"], VIEW_TYPE_EXCALIDRAW);

    this.embedManager = new EmbedManager(this);
    this.embedManager.register();

    this.addRibbonIcon("oh-my-excalidraw", t("newDrawing"), () =>
      void this.createDrawing("tab"),
    );

    this.registerAutoSwitch();

    this.addCommand({
      id: "new",
      name: t("newDrawing"),
      callback: () => void this.createDrawing("tab"),
    });
    this.addCommand({
      id: "new-current",
      name: `${t("newDrawing")} (${t("currentTab")})`,
      callback: () => void this.createDrawing("current"),
    });
    this.addCommand({
      id: "toggle-lock",
      name: t("toggleLock"),
      checkCallback: (checking) => {
        const view = this.activeView();
        if (!view) {
          return false;
        }
        if (!checking) {
          view.toggleLock();
        }
        return true;
      },
    });
    this.addCommand({
      id: "copy-png",
      name: t("copyPng"),
      checkCallback: (checking) => {
        const view = this.activeView();
        if (!view) {
          return false;
        }
        if (!checking) {
          void copyPngToClipboard(this, view);
        }
        return true;
      },
    });
    this.addCommand({
      id: "copy-svg",
      name: t("copySvg"),
      checkCallback: (checking) => {
        const view = this.activeView();
        if (!view) {
          return false;
        }
        if (!checking) {
          void copySvgToClipboard(this, view);
        }
        return true;
      },
    });
    this.addCommand({
      id: "save-png",
      name: t("savePng"),
      checkCallback: (checking) => {
        const view = this.activeView();
        if (!view) {
          return false;
        }
        if (!checking) {
          void savePng(this, view);
        }
        return true;
      },
    });
    this.addCommand({
      id: "save-svg",
      name: t("saveSvg"),
      checkCallback: (checking) => {
        const view = this.activeView();
        if (!view) {
          return false;
        }
        if (!checking) {
          void saveSvg(this, view);
        }
        return true;
      },
    });
    this.addCommand({
      id: "insert-embed",
      name: t("insertEmbed"),
      checkCallback: (checking) => {
        const view = this.app.workspace.getActiveViewOfType(MarkdownView);
        if (!view || !view.file) {
          return false;
        }
        if (!checking) {
          new DrawingPickerModal(this, view.file).open();
        }
        return true;
      },
    });
    this.addCommand({
      id: "open-as-markdown",
      name: t("openAsMarkdown"),
      checkCallback: (checking) => {
        const file = this.activeDrawingFile();
        if (!file) {
          return false;
        }
        if (!checking) {
          this.openAsMarkdown(file);
        }
        return true;
      },
    });

    this.registerEvent(
      this.app.workspace.on("file-menu", (menu: Menu, file) => {
        if (!(file instanceof TFile)) {
          return;
        }
        if (this.isDrawingFile(file)) {
          menu.addItem((item) =>
            item
              .setTitle(t("openAsExcalidraw"))
              .setIcon("oh-my-excalidraw")
              .onClick(() => void this.openDrawing(file)),
          );
          if (file.path.endsWith(".excalidraw.md")) {
            menu.addItem((item) =>
              item
                .setTitle(t("openAsMarkdown"))
                .setIcon("file-text")
                .onClick(() => this.openAsMarkdown(file)),
            );
          }
        }
      }),
    );
  }

  onunload(): void {
    // Obsidian detaches leaves registered via registerView; nothing else to do.
  }

  async loadSettings(): Promise<void> {
    this.settings = Object.assign({}, DEFAULT_SETTINGS, await this.loadData());
  }

  async saveSettings(): Promise<void> {
    await this.saveData(this.settings);
  }

  // --- drawing files ---------------------------------------------------------

  isDrawingFile(file: TFile): boolean {
    return /\.(excalidraw\.md|excalidraw)$/i.test(file.path);
  }

  activeView(): ExcalidrawView | null {
    return this.app.workspace.getActiveViewOfType(ExcalidrawView);
  }

  activeDrawingFile(): TFile | null {
    const view = this.activeView();
    return view?.file ?? null;
  }

  async createDrawing(target: "tab" | "current"): Promise<void> {
    try {
      const folder = normalizePath(this.settings.folder || "Excalidraw");
      if (this.app.vault.getAbstractFileByPath(folder) == null) {
        await this.app.vault.createFolder(folder);
      }
      const stamp = window.moment().format("YYYY-MM-DD HH.mm.ss");
      const path = `${folder}/${this.settings.filenamePrefix}${stamp}.excalidraw.md`;
      const dark = activeDocument.body.hasClass("theme-dark");
      const file = await this.app.vault.create(path, createBlankDrawing(dark));
      this.markdownOverride.delete(path);
      // Open directly in the drawing view (openFile would land in the
      // markdown view first and flash before the auto-switch kicks in).
      const leaf =
        target === "current"
          ? this.app.workspace.getLeaf(false)
          : this.app.workspace.getLeaf("tab");
      await leaf.setViewState({
        type: VIEW_TYPE_EXCALIDRAW,
        state: { file: file.path },
        active: true,
      });
    } catch (e) {
      console.error("[Oh My Excalidraw] create drawing failed", e);
      new Notice(`${t("failedToCreate")}: ${e instanceof Error ? e.message : e}`);
    }
  }

  async openDrawing(file: TFile): Promise<void> {
    this.markdownOverride.delete(file.path);
    const leaf = this.app.workspace.getLeaf(false);
    await leaf.setViewState({
      type: VIEW_TYPE_EXCALIDRAW,
      state: { file: file.path },
      active: true,
    });
  }

  openAsMarkdown(file: TFile): void {
    this.markdownOverride.add(file.path);
    const leaf = this.app.workspace.getLeaf(false);
    void leaf.setViewState({
      type: "markdown",
      state: { file: file.path },
      active: true,
    });
  }

  // --- view type auto-switch -------------------------------------------------

  private registerAutoSwitch(): void {
    this.app.workspace.onLayoutReady(() => {
      let lastFileOpenPath: string | null = null;
      this.registerEvent(
        this.app.workspace.on("file-open", (file) => {
          if (!this.settings.autoOpen || !(file instanceof TFile)) {
            return;
          }
          // Repeated events for the same path are view-type toggles, not
          // file opens — never fight the user's manual switch back.
          if (file.path === lastFileOpenPath) {
            return;
          }
          lastFileOpenPath = file.path;
          if (!this.isDrawingFile(file)) {
            return;
          }
          if (this.markdownOverride.has(file.path)) {
            return;
          }
          const leaf = this.app.workspace.activeLeaf;
          if (!leaf || !(leaf.view instanceof MarkdownView)) {
            return;
          }
          if (leaf.view.file?.path !== file.path) {
            return;
          }
          void leaf.setViewState({
            type: VIEW_TYPE_EXCALIDRAW,
            state: { file: file.path },
            active: true,
          });
        }),
      );
    });
  }
}

class DrawingPickerModal extends FuzzySuggestModal<TFile> {
  constructor(
    private plugin: OhMyExcalidrawPlugin,
    private target: TFile,
  ) {
    super(plugin.app);
    this.setPlaceholder(t("chooseDrawing"));
  }

  getItems(): TFile[] {
    return this.plugin.app.vault
      .getMarkdownFiles()
      .filter((f) => f.path.endsWith(".excalidraw.md"));
  }

  getItemText(item: TFile): string {
    return item.basename.replace(/\.excalidraw$/, "");
  }

  onChooseItem(item: TFile): void {
    const view = this.plugin.app.workspace.getActiveViewOfType(MarkdownView);
    if (!view || !view.editor) {
      return;
    }
    const linktext = this.plugin.app.metadataCache.fileToLinktext(item, this.target.path);
    const editor = view.editor;
    const cursor = editor.getCursor();
    editor.replaceRange(`![[${linktext}]]`, cursor);
    editor.setCursor(editor.offsetToPos(editor.posToOffset(cursor) + linktext.length + 5));
  }
}
