import { Notice, TFile, normalizePath } from "obsidian";
import { exportToBlob, exportToSvg, MIME_TYPES } from "@excalidraw/excalidraw";
import type { AppState, BinaryFiles } from "@excalidraw/excalidraw/types";
import type { OrderedExcalidrawElement } from "@excalidraw/excalidraw/element/types";
import OhMyExcalidrawPlugin from "./main";
import ExcalidrawView from "./view";
import { t } from "./lang";

interface ExportSource {
  elements: readonly OrderedExcalidrawElement[];
  appState: Partial<AppState>;
  files: BinaryFiles;
  theme: "light" | "dark";
  file: TFile | null;
  transparent: boolean;
}

function exportAppState(source: ExportSource, scale: number): Partial<AppState> {
  return {
    ...source.appState,
    exportBackground: !source.transparent,
    exportWithDarkMode: source.theme === "dark",
    exportScale: scale,
  } as Partial<AppState>;
}

function viewSource(plugin: OhMyExcalidrawPlugin, view: ExcalidrawView): ExportSource | null {
  const scene = view.getScene();
  if (!scene || scene.elements.length === 0) {
    new Notice(t("noActiveDrawing"));
    return null;
  }
  return {
    elements: scene.elements,
    appState: scene.appState,
    files: scene.files,
    theme: view.currentTheme,
    file: view.getDrawingFile(),
    transparent: plugin.settings.exportTransparent,
  };
}

export async function copyPngToClipboard(
  plugin: OhMyExcalidrawPlugin,
  view: ExcalidrawView,
): Promise<void> {
  const source = viewSource(plugin, view);
  if (!source) {
    return;
  }
  try {
    const blob = await exportToBlob({
      elements: source.elements,
      appState: exportAppState(source, plugin.settings.exportScale),
      files: source.files,
      mimeType: MIME_TYPES.png,
      quality: 1,
    } as any);
    await navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
    new Notice(t("copiedToClipboard"));
  } catch (e) {
    console.error("[Oh My Excalidraw] PNG copy failed", e);
    new Notice(`${t("exportFailed")}: ${e instanceof Error ? e.message : e}`);
  }
}

export async function copySvgToClipboard(
  plugin: OhMyExcalidrawPlugin,
  view: ExcalidrawView,
): Promise<void> {
  const source = viewSource(plugin, view);
  if (!source) {
    return;
  }
  try {
    const svg = await exportToSvg({
      elements: source.elements,
      appState: exportAppState(source, 1),
      files: source.files,
    } as any);
    await navigator.clipboard.writeText(svg.outerHTML);
    new Notice(t("copiedToClipboard"));
  } catch (e) {
    console.error("[Oh My Excalidraw] SVG copy failed", e);
    new Notice(`${t("exportFailed")}: ${e instanceof Error ? e.message : e}`);
  }
}

export async function savePng(
  plugin: OhMyExcalidrawPlugin,
  view: ExcalidrawView,
): Promise<void> {
  const source = viewSource(plugin, view);
  if (!source) {
    return;
  }
  try {
    const blob = await exportToBlob({
      elements: source.elements,
      appState: exportAppState(source, plugin.settings.exportScale),
      files: source.files,
      mimeType: MIME_TYPES.png,
      quality: 1,
    } as any);
    const buffer = await blob.arrayBuffer();
    const path = await exportPath(plugin, source.file, "png");
    await plugin.app.vault.createBinary(path, buffer);
    new Notice(t("exportedTo").replace("{0}", path));
  } catch (e) {
    console.error("[Oh My Excalidraw] PNG save failed", e);
    new Notice(`${t("exportFailed")}: ${e instanceof Error ? e.message : e}`);
  }
}

export async function saveSvg(
  plugin: OhMyExcalidrawPlugin,
  view: ExcalidrawView,
): Promise<void> {
  const source = viewSource(plugin, view);
  if (!source) {
    return;
  }
  try {
    const svg = await exportToSvg({
      elements: source.elements,
      appState: exportAppState(source, 1),
      files: source.files,
    } as any);
    const path = await exportPath(plugin, source.file, "svg");
    await plugin.app.vault.create(
      path,
      `<?xml version="1.0" encoding="UTF-8"?>\n${svg.outerHTML}`,
    );
    new Notice(t("exportedTo").replace("{0}", path));
  } catch (e) {
    console.error("[Oh My Excalidraw] SVG save failed", e);
    new Notice(`${t("exportFailed")}: ${e instanceof Error ? e.message : e}`);
  }
}

async function exportPath(
  plugin: OhMyExcalidrawPlugin,
  file: TFile | null,
  ext: "png" | "svg",
): Promise<string> {
  const folder = normalizePath(
    plugin.settings.exportFolder || "Excalidraw/Exports",
  );
  if (plugin.app.vault.getAbstractFileByPath(folder) == null) {
    await plugin.app.vault.createFolder(folder);
  }
  const base = (file?.basename ?? "drawing").replace(/\.excalidraw$/, "");
  const stamp = window.moment().format("YYYY-MM-DD HH.mm.ss");
  let path = `${folder}/${base} ${stamp}.${ext}`;
  let i = 1;
  while (plugin.app.vault.getAbstractFileByPath(path) != null) {
    path = `${folder}/${base} ${stamp} (${i++}).${ext}`;
  }
  return path;
}
