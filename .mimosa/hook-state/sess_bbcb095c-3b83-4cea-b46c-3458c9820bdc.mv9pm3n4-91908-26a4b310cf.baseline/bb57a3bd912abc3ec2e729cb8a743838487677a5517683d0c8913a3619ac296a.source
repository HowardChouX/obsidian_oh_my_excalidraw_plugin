import { App, PluginSettingTab, Setting } from "obsidian";
import OhMyExcalidrawPlugin from "./main";
import { t } from "./lang";

export interface PluginSettings {
  folder: string;
  filenamePrefix: string;
  autosaveInterval: number;
  compress: boolean;
  defaultFont: "hand-drawn" | "normal" | "code" | "excalifont";
  exportFolder: string;
  exportScale: number;
  exportTransparent: boolean;
  embedMatchTheme: boolean;
  autoOpen: boolean;
  editorLanguage: "auto" | "zh-CN" | "en";
}

export const DEFAULT_SETTINGS: PluginSettings = {
  folder: "Excalidraw",
  filenamePrefix: "Drawing ",
  autosaveInterval: 2000,
  compress: false,
  defaultFont: "excalifont",
  exportFolder: "Excalidraw/Exports",
  exportScale: 2,
  exportTransparent: false,
  embedMatchTheme: false,
  autoOpen: true,
  editorLanguage: "auto",
};

export class SettingsTab extends PluginSettingTab {
  constructor(app: App, private plugin: OhMyExcalidrawPlugin) {
    super(app, plugin);
  }

  display(): void {
    const { containerEl } = this;
    containerEl.empty();
    const s = this.plugin.settings;

    new Setting(containerEl)
      .setName(t("settingsFolder"))
      .setDesc(t("settingsFolderDesc"))
      .addText((text) =>
        text
          .setValue(s.folder)
          .onChange(async (value) => {
            s.folder = value;
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsFilenamePrefix"))
      .setDesc(t("settingsFilenamePrefixDesc"))
      .addText((text) =>
        text
          .setValue(s.filenamePrefix)
          .onChange(async (value) => {
            s.filenamePrefix = value;
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsAutoOpen"))
      .setDesc(t("settingsAutoOpenDesc"))
      .addToggle((toggle) =>
        toggle
          .setValue(s.autoOpen)
          .onChange(async (value) => {
            s.autoOpen = value;
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsAutosave"))
      .setDesc(t("settingsAutosaveDesc"))
      .addText((text) =>
        text
          .setValue(String(s.autosaveInterval))
          .onChange(async (value) => {
            const n = Math.max(300, parseInt(value) || 2000);
            s.autosaveInterval = n;
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsCompress"))
      .setDesc(t("settingsCompressDesc"))
      .addToggle((toggle) =>
        toggle
          .setValue(s.compress)
          .onChange(async (value) => {
            s.compress = value;
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsDefaultFont"))
      .addDropdown((dd) =>
        dd
          .addOptions({
            excalifont: "Excalifont",
            "hand-drawn": "Virgil (legacy)",
            normal: "Nunito",
            code: "Cascadia",
          })
          .setValue(s.defaultFont)
          .onChange(async (value) => {
            s.defaultFont = value as PluginSettings["defaultFont"];
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsLanguage"))
      .addDropdown((dd) =>
        dd
          .addOptions({ auto: "Auto", "zh-CN": "中文", en: "English" })
          .setValue(s.editorLanguage)
          .onChange(async (value) => {
            s.editorLanguage = value as PluginSettings["editorLanguage"];
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsExportFolder"))
      .addText((text) =>
        text
          .setValue(s.exportFolder)
          .onChange(async (value) => {
            s.exportFolder = value;
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsExportScale"))
      .addDropdown((dd) =>
        dd
          .addOptions({ "1": "1x", "2": "2x", "3": "3x" })
          .setValue(String(s.exportScale))
          .onChange(async (value) => {
            s.exportScale = parseInt(value);
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsExportBackground"))
      .setDesc(t("settingsExportBackgroundDesc"))
      .addToggle((toggle) =>
        toggle
          .setValue(s.exportTransparent)
          .onChange(async (value) => {
            s.exportTransparent = value;
            await this.plugin.saveSettings();
          }),
      );

    new Setting(containerEl)
      .setName(t("settingsEmbedTheme"))
      .setDesc(t("settingsEmbedThemeDesc"))
      .addToggle((toggle) =>
        toggle
          .setValue(s.embedMatchTheme)
          .onChange(async (value) => {
            s.embedMatchTheme = value;
            await this.plugin.saveSettings();
          }),
      );
  }
}
