/**
 * The .excalidraw.md file format engine.
 *
 * The format is byte-compatible with zsviczian/obsidian-excalidraw-plugin:
 *
 *   ---
 *   (frontmatter)
 *   ---
 *   ==banner==
 *   (user markdown header, preserved verbatim)
 *   # Excalidraw Data
 *
 *   ## Text Elements
 *   <raw text> ^<element id>
 *
 *   ## Element Links        (only when some element has a link)
 *   <element id>: <link>
 *
 *   %%                       (opens the comment hiding the drawing section in reading mode)
 *   ## Drawing
 *   ```json                  (or ```compressed-json with lz-string base64, 256-char chunks)
 *   {"type":"excalidraw",...,"elements":[...],"appState":{...},"files":{...}}
 *   ```
 *   %%
 *
 * The Drawing JSON is the single source of truth for this plugin. The Text
 * Elements / Element Links sections are regenerated from the scene on every
 * save so the original plugin (which reads them back) stays in sync.
 */
import LZString from "lz-string";
import type { OrderedExcalidrawElement } from "@excalidraw/excalidraw/element/types";
import type {
  AppState,
  BinaryFiles,
} from "@excalidraw/excalidraw/types";

export interface SceneData {
  type: string;
  version: number;
  source: string;
  elements: readonly OrderedExcalidrawElement[];
  appState: Partial<AppState>;
  files: BinaryFiles;
}

export interface ParsedDrawing {
  /** User markdown between the banner and "# Excalidraw Data", kept verbatim. */
  header: string;
  /** Everything before the user header: frontmatter + banner. */
  prefix: string;
  scene: SceneData | null;
  /** True when the Drawing section was ```compressed-json. */
  compressed: boolean;
  /** True for plain .excalidraw JSON files (no markdown wrapper). */
  rawJson: boolean;
}

const PLUGIN_VERSION = "0.1.0";

export const FRONTMATTER = [
  "---",
  "",
  "excalidraw-plugin: parsed",
  "tags: [excalidraw]",
  "",
  "---",
  "==⚠  Switch to EXCALIDRAW VIEW in the MORE OPTIONS menu of this document. ⚠== You can decompress Drawing data with the command palette: 'Decompress current Excalidraw file'. For more info check in plugin settings under 'Saving'",
  "",
  "",
  "",
].join("\n");

// Mirrors the original plugin's DRAWING_REG / DRAWING_COMPRESSED_REG.
const DRAWING_JSON_REG = /\n##? Drawing\n[^`]*(```json\n)([\s\S]*?)```\n/m;
const DRAWING_JSON_FALLBACK = /\n##? Drawing\n(```json\n)?(.*?)(```)?(%%)?\s*$/m;
const DRAWING_COMPRESSED_REG =
  /\n##? Drawing\n[^`]*(?:```compressed-json\n)([\s\S]*?)```\n/m;
const DRAWING_COMPRESSED_FALLBACK =
  /\n##? Drawing\n(?:```compressed-json\n)?(.*?)(```)?(%%)?\s*$/m;

const EXCALIDRAW_DATA_REG = /(?:^|\n)(?:%%\n+)?# Excalidraw Data(?:\n|$)/m;
const TEXTELEMENTS_REG = /(?:^|\n)(?:%%\n+)?##? Text Elements(?:\n|$)/m;

/** lz-string compressToBase64 chunked into 256-char lines (original plugin format). */
export function compressScene(json: string): string {
  const compressed = LZString.compressToBase64(json);
  const chunks: string[] = [];
  for (let i = 0; i < compressed.length; i += 256) {
    chunks.push(compressed.slice(i, i + 256));
  }
  return chunks.join("\n\n").trim();
}

export function decompressScene(data: string): string | null {
  return LZString.decompressFromBase64(data.replace(/[\n\r]/g, ""));
}

export function isExcalidrawMarkdown(content: string): boolean {
  return (
    EXCALIDRAW_DATA_REG.test(content) ||
    TEXTELEMENTS_REG.test(content) ||
    /\n##? Drawing\n/.test(content)
  );
}

function extractSceneJson(content: string): {
  json: string | null;
  compressed: boolean;
} {
  let m = content.match(DRAWING_COMPRESSED_REG);
  if (m) {
    return { json: decompressScene(m[1]), compressed: true };
  }
  m = content.match(DRAWING_COMPRESSED_FALLBACK);
  if (m && m[1] && m[1].length > 10) {
    const json = decompressScene(m[1]);
    if (json) {
      return { json, compressed: true };
    }
  }
  m = content.match(DRAWING_JSON_REG);
  if (m) {
    return { json: m[2], compressed: false };
  }
  m = content.match(DRAWING_JSON_FALLBACK);
  if (m && m[2] && m[2].trim().startsWith("{")) {
    return { json: m[2], compressed: false };
  }
  return { json: null, compressed: false };
}

function parseSceneJson(json: string | null): SceneData | null {
  if (!json) {
    return null;
  }
  // Same sync-merge workaround as the original: cut trailing garbage after the
  // last closing brace.
  const cut = json.lastIndexOf("}");
  if (cut === -1) {
    return null;
  }
  let scene: any;
  try {
    scene = JSON.parse(json.substring(0, cut + 1));
  } catch {
    return null;
  }
  if (!scene || !Array.isArray(scene.elements)) {
    return null;
  }
  return {
    type: scene.type ?? "excalidraw",
    version: scene.version ?? 2,
    source: scene.source ?? "",
    elements: scene.elements,
    appState: scene.appState ?? {},
    files: scene.files ?? {},
  };
}

/** Splits frontmatter+banner+user-header away from the generated sections. */
function splitHeader(content: string): { prefix: string; header: string } {
  const dataMatch = content.match(EXCALIDRAW_DATA_REG);
  if (dataMatch && dataMatch.index !== undefined) {
    // strip the leading \n from the match so the header keeps its final newline
    const start =
      dataMatch.index + (dataMatch[0].startsWith("\n") ? 1 : 0);
    let before = content.slice(0, start);
    // When "%%\n" directly precedes "# Excalidraw Data", the %% belongs to the
    // generated section, not the user header.
    if (/(^|\n)%%\n+$/.test(before)) {
      before = before.replace(/%%\n+$/, "");
    }
    // Prefix = frontmatter + banner; header = user markdown after the banner.
    const fmEnd = findFrontmatterEnd(before);
    if (fmEnd === -1) {
      return { prefix: "", header: before };
    }
    return { prefix: before.slice(0, fmEnd), header: before.slice(fmEnd) };
  }
  // Files without the marker: treat everything before "## Drawing" as header.
  const drawingMatch = content.match(/\n##? Drawing\n/m);
  const cut = drawingMatch?.index ?? content.length;
  return { prefix: "", header: content.slice(0, cut) };
}

function findFrontmatterEnd(content: string): number {
  if (!content.startsWith("---")) {
    // No frontmatter: prefix is just the banner if present.
    const bannerMatch = content.match(
      /^==⚠  Switch to EXCALIDRAW VIEW[^\n]*\n(?:\n)*/,
    );
    return bannerMatch ? bannerMatch[0].length : 0;
  }
  const end = content.indexOf("\n---", 3);
  if (end === -1) {
    return 0;
  }
  const afterEnd = content.indexOf("\n", end + 1);
  const nextLineEnd = afterEnd === -1 ? content.length : afterEnd;
  // Banner line may follow the frontmatter; keep it in the prefix.
  const rest = content.slice(Math.min(nextLineEnd + 1, content.length));
  const bannerMatch = rest.match(
    /^==⚠  Switch to EXCALIDRAW VIEW[^\n]*\n(?:\n)*/,
  );
  return (
    Math.min(nextLineEnd + 1, content.length) +
    (bannerMatch ? bannerMatch[0].length : 0)
  );
}

export function parseDrawing(content: string): ParsedDrawing {
  // Plain .excalidraw JSON file.
  if (content.trimStart().startsWith("{")) {
    return {
      prefix: "",
      header: "",
      scene: parseSceneJson(content.trim()),
      compressed: false,
      rawJson: true,
    };
  }
  const { json, compressed } = extractSceneJson(content);
  const { prefix, header } = splitHeader(content);
  return {
    prefix,
    header,
    scene: parseSceneJson(json),
    compressed,
    rawJson: false,
  };
}

/** Keys of appState we keep persisting across saves. */
function mergeAppState(
  persisted: Partial<AppState>,
  current: Partial<AppState>,
): Partial<AppState> {
  const merged: any = { ...persisted };
  for (const key of [
    "viewBackgroundColor",
    "gridSize",
    "exportBackground",
    "zoom",
    "scrollX",
    "scrollY",
  ]) {
    if (current[key as keyof AppState] !== undefined) {
      merged[key] = current[key as keyof AppState];
    }
  }
  return merged as Partial<AppState>;
}

/** Builds the "## Text Elements" + "## Element Links" sections from the scene. */
function buildTextSections(scene: SceneData): string {
  let out = "";
  const links: string[] = [];
  const seen = new Set<string>();
  for (const element of scene.elements) {
    if (seen.has(element.id)) {
      continue;
    }
    seen.add(element.id);
    if (element.type === "text") {
      const textElement = element as { text?: string; originalText?: string };
      const raw = textElement.originalText ?? textElement.text ?? "";
      out += `${raw} ^${element.id}\n\n`;
    }
    if ((element as any).link) {
      links.push(`${element.id}: ${(element as any).link}\n\n`);
    }
  }
  if (links.length > 0) {
    out += `## Element Links\n${links.join("")}`;
  }
  return out;
}

export interface SerializeOptions {
  /** Write ```compressed-json instead of plain ```json. Default false. */
  compress?: boolean;
}

export function serializeDrawing(
  parsed: ParsedDrawing,
  scene: SceneData,
  options: SerializeOptions = {},
): string {
  if (parsed.rawJson) {
    return JSON.stringify(
      {
        type: scene.type,
        version: scene.version,
        source: scene.source,
        elements: scene.elements,
        appState: scene.appState,
        files: scene.files,
      },
      null,
      "\t",
    );
  }

  const prefix = parsed.prefix || FRONTMATTER;
  const header =
    parsed.header === "" ? "" : ensureTrailingNewline(parsed.header);

  const sceneJson = JSON.stringify(
    {
      type: scene.type,
      version: scene.version,
      source: scene.source,
      elements: scene.elements,
      appState: scene.appState,
      files: scene.files,
    },
    null,
    "\t",
  );

  const drawingSection = options.compress
    ? `## Drawing\n\`\`\`compressed-json\n${compressScene(sceneJson)}\n\`\`\`\n%%`
    : `## Drawing\n\`\`\`json\n${sceneJson}\n\`\`\`\n%%`;

  return (
    prefix +
    header +
    "# Excalidraw Data\n\n## Text Elements\n" +
    buildTextSections(scene) +
    "%%\n" +
    drawingSection
  );
}

function ensureTrailingNewline(s: string): string {
  if (s === "") {
    return "";
  }
  return s.endsWith("\n") ? s : s + "\n";
}

export function createBlankScene(dark: boolean): SceneData {
  const appState: any = {
    gridSize: null,
    viewBackgroundColor: dark ? "#121212" : "#ffffff",
  };
  if (dark) {
    appState.theme = "dark";
  }
  return {
    type: "excalidraw",
    version: 2,
    source: `https://github.com/zsviczian/obsidian-excalidraw-plugin/releases/tag/v${PLUGIN_VERSION}`,
    elements: [],
    appState,
    files: {},
  };
}

export function createBlankDrawing(dark: boolean): string {
  return serializeDrawing(
    { prefix: FRONTMATTER, header: "", scene: null, compressed: false, rawJson: false },
    createBlankScene(dark),
  );
}

export { mergeAppState };
