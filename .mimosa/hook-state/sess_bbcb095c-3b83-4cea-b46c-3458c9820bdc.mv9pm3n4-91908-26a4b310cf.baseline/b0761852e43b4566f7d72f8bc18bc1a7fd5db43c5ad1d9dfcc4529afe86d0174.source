import { TFile } from "obsidian";
import { exportToSvg } from "@excalidraw/excalidraw";
import OhMyExcalidrawPlugin from "./main";
import { parseDrawing } from "./data";

interface CacheEntry {
  mtime: number;
  svg: string | null;
}

/**
 * Renders `![[drawing.excalidraw.md]]` embeds in markdown preview/live preview
 * as SVG snapshots of the scene. Results are cached per file + mtime; when a
 * drawing changes on disk every live embed is re-rendered in place.
 */
export class EmbedManager {
  private cache = new Map<string, CacheEntry>();
  /** Live embed containers per file path, for in-place refresh. */
  private live = new Map<string, Set<HTMLElement>>();
  private renderToken = 0;

  constructor(private plugin: OhMyExcalidrawPlugin) {}

  register(): void {
    this.plugin.registerMarkdownPostProcessor((el, ctx) => {
      this.process(el, ctx.sourcePath);
    });
    this.plugin.registerEvent(
      this.plugin.app.vault.on("modify", (file) => {
        if (file instanceof TFile && this.invalidate(file.path)) {
          this.refreshLive(file.path);
        }
      }),
    );
    this.plugin.registerEvent(
      this.plugin.app.vault.on("delete", (file) => {
        if (file instanceof TFile) {
          this.invalidate(file.path);
          this.live.delete(file.path);
        }
      }),
    );
    this.plugin.registerEvent(
      this.plugin.app.vault.on("rename", (file, oldPath) => {
        if (file instanceof TFile) {
          this.invalidate(oldPath);
          this.live.delete(oldPath);
        }
      }),
    );
  }

  private invalidate(path: string): boolean {
    return this.cache.delete(path);
  }

  private refreshLive(path: string): void {
    const containers = this.live.get(path);
    if (!containers) {
      return;
    }
    for (const container of [...containers]) {
      if (!container.isConnected) {
        containers.delete(container);
        continue;
      }
      void this.fill(container, path);
    }
  }

  private process(el: HTMLElement, sourcePath: string): void {
    if (!sourcePath) {
      return;
    }
    const embeds = el.querySelectorAll<HTMLElement>(".internal-embed");
    if (embeds.length === 0) {
      return;
    }
    for (const embed of Array.from(embeds)) {
      const src = embed.getAttribute("src") ?? "";
      if (!/\.excalidraw(\.md)?$/i.test(src)) {
        continue;
      }
      const file = this.plugin.app.metadataCache.getFirstLinkpathDest(
        src.replace(/[#|].*$/, ""),
        sourcePath,
      );
      if (!(file instanceof TFile)) {
        continue;
      }
      // Obsidian puts the embed alias in `alt`; a numeric alias means width.
      const alt = embed.getAttribute("alt") ?? "";
      const width = parseInt(embed.getAttribute("width") ?? alt, 10);

      embed.empty();
      embed.addClass("oh-my-excalidraw-embed-wrapper");
      const container = embed.createDiv({ cls: "oh-my-excalidraw-embed" });
      if (!Number.isNaN(width) && width > 0) {
        container.style.width = `${width}px`;
      }
      container.createSpan({ cls: "oh-my-excalidraw-embed-loading", text: "…" });

      container.addEventListener("click", (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        this.plugin.app.workspace.getLeaf().openFile(file);
      });

      let set = this.live.get(file.path);
      if (!set) {
        set = new Set();
        this.live.set(file.path, set);
      }
      set.add(container);

      void this.fill(container, file.path);
    }
  }

  private async fill(container: HTMLElement, path: string): Promise<void> {
    const token = ++this.renderToken;
    const svg = await this.getSvg(path);
    if (token !== this.renderToken || !container.isConnected) {
      return;
    }
    container.empty();
    if (svg) {
      container.innerHTML = svg;
      const svgEl = container.querySelector("svg");
      if (svgEl) {
        svgEl.style.maxWidth = "100%";
        svgEl.style.height = "auto";
        svgEl.style.display = "block";
      }
    }
  }

  private async getSvg(path: string): Promise<string | null> {
    const file = this.plugin.app.vault.getFileByPath(path);
    if (!(file instanceof TFile)) {
      return null;
    }
    const cached = this.cache.get(path);
    if (cached && cached.mtime === file.stat.mtime) {
      return cached.svg;
    }
    let svg: string | null = null;
    try {
      const content = await this.plugin.app.vault.read(file);
      const parsed = parseDrawing(content);
      if (parsed.scene && parsed.scene.elements.length > 0) {
        const matchTheme = this.plugin.settings.embedMatchTheme;
        const useDark = matchTheme
          ? activeDocument.body.hasClass("theme-dark")
          : parsed.scene.appState.theme === "dark";
        const svgEl = await exportToSvg({
          elements: parsed.scene.elements,
          appState: {
            ...parsed.scene.appState,
            exportWithDarkMode: useDark,
          },
          files: parsed.scene.files,
        } as any);
        svg = svgEl.outerHTML;
      }
    } catch (e) {
      console.error("[Oh My Excalidraw] embed render failed", path, e);
    }
    this.cache.set(path, { mtime: file.stat.mtime, svg });
    return svg;
  }
}
